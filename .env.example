# ============================================================
# PAKISTAN AI — Frontend Environment Configuration
# Copy this file to Frontend/.env and customize as needed.
# ============================================================

# Website Base URL (used for canonical tags, OpenGraph previews, and Schema.org structured data)
# In local development: http://localhost:5173
# In production: https://pakistan-ai.app (or https://your-deployment-url.com)
VITE_SITE_URL=http://localhost:5173

# Backend API endpoint URL (Express backend)
# In local development: http://localhost:5000/api
# In production: https://api.pakistan-ai.app/api (or /api if reverse proxied)
VITE_API_URL=http://localhost:5000/api

# Telegram bot username (optional, without @)
VITE_TELEGRAM_BOT_USERNAME=pakistan_ai_bot

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
